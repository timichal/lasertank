# ---------------------------------------------------------------
# LaserTank port
#
# NOTE: this repo deliberately COMMITS binary data. The level and
# score files are the test corpus, and original/ is a frozen
# historical artifact. Do not add blanket *.exe / *.zip / *.lvl
# rules — they would gut the project.
# ---------------------------------------------------------------

# --- user / runtime state, regenerated by the game ---
# Scoped to where the game actually writes, so original/src/Setups/*.ini
# (part of the frozen 2007 distribution) stays tracked.
/original/bin/*.hs
/original/bin/*.ini
/data/**/*.hs
/*.hs
/*.ini

# --- our build output ---
/oracle/build/
/oracle/bin/
/tools/**/bin/
/tools/**/obj/
*.o
*.exe.tmp
__pycache__/
*.pyc

# --- Godot (phase 2+) ---
/godot/.godot/
/godot/.mono/
/godot/bin/
/godot/obj/
/godot/*.tmp

# --- traces, fuzz artifacts, solver output (large and regenerable) ---
/out/
/traces/
*.trace
*.trace.gz

# --- editor / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
