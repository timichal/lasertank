; LaserTank -- Phase 5, the presentation layer.
;
; The game logic is LaserTank.Core, referenced as a plain library.  This project
; only draws it: no rules live here.  See PROGRESS.md, "Phase 5".

config_version=5

[application]

config/name="LaserTank"
config/description="Godot port of LaserTank 4.1.2 (Jim Kindley / Yves Maingoy), public domain."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]

; The board at the default 32 px zoom, plus the HUD strip.  BoardView
; resizes the window when the zoom changes, exactly as SetGameSize does.
window/size/viewport_width=544
window/size/viewport_height=670

[physics]

; The tick.  GameDelay = 50 ms (LTANK.H:96) is 20 Hz, and BoardView refuses to
; start if this setting and that constant disagree -- the logic rate is the one
; number in this project that must not drift.  _PhysicsProcess drives Tick();
; _Process only redraws (hazard #10).
common/physics_ticks_per_second=20

; A frame that fell far behind must not run a burst of game ticks: 4 is 200 ms
; of catch-up, past which the game simply runs slow rather than teleporting.
common/max_physics_steps_per_frame=4

[dotnet]

project/assembly_name="LaserTank.Game"

[rendering]

; Pixel art: the sheet is a native 32x32 grid scaled at draw time, so nearest
; is the only filter that keeps it looking like the original.
textures/canvas_textures/default_texture_filter=0
