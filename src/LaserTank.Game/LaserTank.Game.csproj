<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- Phase 5: the presentation layer.  It references LaserTank.Core as a
       plain library.  Core has no Godot dependency, which is what makes this
       a reference rather than a rewrite.  Nothing in here decides anything:
       it reads Game.PF / Game.BMF and draws them. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LaserTank.Game</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../LaserTank.Core/LaserTank.Core.csproj" />
  </ItemGroup>

</Project>
